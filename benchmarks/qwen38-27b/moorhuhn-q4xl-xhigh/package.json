{
  "name": "moorland-mayhem-featherstorm",
  "description": "Moorland Mayhem - Featherstorm: ein eigeninterpretiertes Moorhuhn-artiges 2D-Arcade-Shooter-Spiel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.cjs",
    "lint:fix": "eslint . --ext .ts,.cjs --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.ts\""
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
